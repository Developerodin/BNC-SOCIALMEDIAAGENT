{%- comment -%}
  "Ask our AI agent": an inline section below the Buy buttons. The merchant's own questions become pills; with none,
  askcart-ask-ai.js fetches AI-written questions for this product from our server. Tapping a pill or sending the input
  asks the AskCart embed to open the chat as a drawer with that question sent (`askcart:open`, see ask-ai-block.ts).
  It renders visible so the page doesn't jump when the script loads; the script hides it when the AskCart embed is off,
  so nothing is left that does nothing. The pills' space is reserved (data-askcart-loading) until they arrive. Every value leaves Liquid through `escape` (Review Focus 2); the script builds the pills with textContent.
{%- endcomment -%}
{%- assign cfg = app.metafields.askcart.widget.value -%}
{%- if product and cfg.enabled and cfg.apiBase != blank -%}
  {%- assign eyebrow = block.settings.eyebrow -%}
  {%- if eyebrow == blank -%}{%- assign eyebrow = 'ask_ai.eyebrow' | t -%}{%- endif -%}
  {%- assign pill_count = 0 -%}
  {%- if block.settings.question_1 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if block.settings.question_2 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if block.settings.question_3 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if pill_count == 0 -%}{%- assign pill_count = 3 -%}{%- endif -%}
  {%- assign heading = block.settings.heading -%}
  {%- if heading == blank -%}{%- assign heading = 'ask_ai.heading' | t -%}{%- endif -%}
  <div
    class="askcart-ai"
    data-askcart-ask-ai
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product="{{ product.id | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-api="{{ cfg.apiBase | escape }}"
    data-accent="{{ cfg.accent | escape }}"
    data-q1="{{ block.settings.question_1 | escape }}"
    data-q2="{{ block.settings.question_2 | escape }}"
    data-q3="{{ block.settings.question_3 | escape }}"
    {{ block.shopify_attributes }}
  >
    <p class="askcart-ai__eyebrow" data-askcart-eyebrow>{{ eyebrow | escape }}</p>
    <h2 class="askcart-ai__heading" data-askcart-heading>{{ heading | escape }}</h2>
    <div class="askcart-ai__pills" data-askcart-pills data-askcart-loading style="--askcart-pills: {{ pill_count | escape }}"></div>
    <form class="askcart-ai__form" data-askcart-form>
      <input
        class="askcart-ai__input"
        type="text"
        name="question"
        maxlength="2000"
        autocomplete="off"
        placeholder="{{ 'ask_ai.placeholder' | t | escape }}"
        aria-label="{{ 'ask_ai.placeholder' | t | escape }}"
      >
      <button class="askcart-ai__send" type="submit" aria-label="{{ 'ask_ai.send' | t | escape }}">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 4l7 7-1.41 1.41L13 7.83V20h-2V7.83l-4.59 4.58L5 11z"/></svg>
      </button>
    </form>
    {%- if block.settings.show_note -%}
      <p class="askcart-ai__note">{{ 'ask_ai.note' | t | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ask our AI agent",
  "target": "section",
  "javascript": "askcart-ask-ai.js",
  "stylesheet": "askcart-ask-ai.css",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above the heading", "info": "Leave empty for the translated default." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty for the translated default." },
    { "type": "header", "content": "Suggested questions" },
    { "type": "paragraph", "content": "Leave all three empty and the AI writes questions for each product." },
    { "type": "text", "id": "question_1", "label": "Question 1" },
    { "type": "text", "id": "question_2", "label": "Question 2" },
    { "type": "text", "id": "question_3", "label": "Question 3" },
    { "type": "checkbox", "id": "show_note", "label": "Show the note under the input", "default": true }
  ]
}
{% endschema %}
