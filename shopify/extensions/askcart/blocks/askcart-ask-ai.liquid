{%- comment -%}
  "Ask our AI agent": an inline section below the Buy buttons. The merchant's own questions become pills; with none,
  askcart-ask-ai.js fetches AI-written questions for this product from our server. Tapping a pill or sending the input
  asks the AskCart embed to open the chat as a drawer with that question sent (`askcart:open`, see ask-ai-block.ts).
  It renders visible so the page doesn't jump when the script loads; the script hides it when the AskCart embed is off,
  so nothing is left that does nothing. The pills' space is reserved (data-askcart-loading) until they arrive. Every value leaves Liquid through `escape` (Review Focus 2); the script builds the pills with textContent.
{%- endcomment -%}
{%- assign cfg = app.metafields.askcart.widget.value -%}
{%- if product and cfg.enabled and cfg.apiBase != blank -%}
  {%- assign eyebrow = block.settings.eyebrow -%}
  {%- if eyebrow == blank -%}{%- assign eyebrow = 'ask_ai.eyebrow' | t -%}{%- endif -%}
  {%- assign pill_count = 0 -%}
  {%- if block.settings.question_1 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if block.settings.question_2 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if block.settings.question_3 != blank -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
  {%- if pill_count == 0 -%}{%- assign pill_count = 3 -%}{%- endif -%}
  {%- assign heading = block.settings.heading -%}
  {%- if heading == blank -%}{%- assign heading = 'ask_ai.heading' | t -%}{%- endif -%}
  <div
    class="askcart-ai"
    data-askcart-ask-ai
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product="{{ product.id | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-api="{{ cfg.apiBase | escape }}"
    data-accent="{{ cfg.accent | escape }}"
    data-q1="{{ block.settings.question_1 | escape }}"
    data-q2="{{ block.settings.question_2 | escape }}"
    data-q3="{{ block.settings.question_3 | escape }}"
    {{ block.shopify_attributes }}
  >
    <p class="askcart-ai__eyebrow" data-askcart-eyebrow>{{ eyebrow | escape }}</p>
    <h2 class="askcart-ai__heading" data-askcart-heading>{{ heading | escape }}</h2>
    <div class="askcart-ai__pills" data-askcart-pills data-askcart-loading style="--askcart-pills: {{ pill_count | escape }}"></div>
    <form class="askcart-ai__form" data-askcart-form>
      <input
        class="askcart-ai__input"
        type="text"
        name="question"
        maxlength="2000"
        autocomplete="off"
        placeholder="{{ 'ask_ai.placeholder' | t | escape }}"
        aria-label="{{ 'ask_ai.placeholder' | t | escape }}"
      >
      <button class="askcart-ai__send" type="submit" aria-label="{{ 'ask_ai.send' | t | escape }}">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 4l7 7-1.41 1.41L13 7.83V20h-2V7.83l-4.59 4.58L5 11z"/></svg>
      </button>
    </form>
    {%- if block.settings.show_note -%}
      <p class="askcart-ai__note">{{ 'ask_ai.note' | t | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* Theme-DOM block, not the widget's shadow-DOM panel: the px-only rule does not apply. Text is in em so it scales
     with the theme's own font size (themes that set html { font-size: 62.5% } break rem); only the 44px touch targets
     are px. Dawn-family variables are used when the theme has them (--font-heading-*, --color-foreground,
     --color-button*, --inputs-radius, --buttons-radius); every one has a neutral fallback or inherits. */
  .askcart-ai { --askcart-gap: 0.75em; --askcart-h: 48px; --askcart-radius: var(--inputs-radius, 8px); --askcart-line: rgba(var(--color-foreground, 127, 127, 127), 0.35); box-sizing: border-box; width: 100%; max-width: 100%; margin: 1.5em 0; font-family: inherit; color: inherit; line-height: 1.4; }
  .askcart-ai *, .askcart-ai *::before, .askcart-ai *::after { box-sizing: border-box; }
  .askcart-ai[hidden] { display: none; }
  .askcart-ai__eyebrow { margin: 0 0 0.25em; font-size: 0.875em; line-height: 1.4; font-weight: 700; opacity: 0.65; }
  .askcart-ai__heading { margin: 0 0 var(--askcart-gap); font-family: var(--font-heading-family, inherit); font-weight: var(--font-heading-weight, 700); font-size: 1.6em; line-height: 1.2; text-transform: uppercase; overflow-wrap: anywhere; }
  .askcart-ai__pills { display: flex; flex-direction: column; gap: var(--askcart-gap); margin: 0 0 var(--askcart-gap); }
  .askcart-ai__pills[data-askcart-loading] { min-height: calc(var(--askcart-pills, 3) * var(--askcart-h) + (var(--askcart-pills, 3) - 1) * var(--askcart-gap)); }
  .askcart-ai__pills:empty:not([data-askcart-loading]) { display: none; }
  .askcart-ai__pill { display: flex; align-items: center; gap: 0.75em; width: 100%; min-height: var(--askcart-h); margin: 0; padding: 0.5em 1.1em; border: 1px solid var(--askcart-line); border-radius: var(--askcart-radius); background: transparent; color: inherit; font: inherit; line-height: 1.35; text-align: left; text-transform: none; letter-spacing: normal; cursor: pointer; }
  .askcart-ai__pill span { min-width: 0; overflow-wrap: anywhere; }
  .askcart-ai__pill:hover { border-color: currentColor; }
  .askcart-ai__pill svg { flex: none; width: 1.2em; height: 1.2em; }
  .askcart-ai__form { display: flex; align-items: center; gap: 0.5em; width: 100%; min-height: var(--askcart-h); margin: 0; padding: 0 2px 0 1.1em; border: 1px solid var(--askcart-line); border-radius: var(--askcart-radius); }
  .askcart-ai__form:focus-within { border-color: currentColor; }
  .askcart-ai__input { flex: 1; min-width: 0; margin: 0; padding: 0.5em 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; color: inherit; font: inherit; font-size: max(1em, 16px); line-height: 1.4; outline: 0; }
  .askcart-ai__send { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: 0; padding: 0; border: 0; border-radius: var(--buttons-radius, var(--askcart-radius)); background: rgb(var(--color-button, var(--askcart-ai-accent-rgb, 10, 10, 10))); color: rgb(var(--color-button-text, var(--askcart-ai-on-rgb, 255, 255, 255))); cursor: pointer; }
  .askcart-ai__pill:focus-visible, .askcart-ai__send:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .askcart-ai__note { margin: var(--askcart-gap) 0 0; font-size: 0.8em; line-height: 1.4; opacity: 0.65; }
{% endstylesheet %}

{% schema %}
{
  "name": "Ask our AI agent",
  "target": "section",
  "javascript": "askcart-ask-ai.js",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above the heading", "info": "Leave empty for the translated default." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty for the translated default." },
    { "type": "header", "content": "Suggested questions" },
    { "type": "paragraph", "content": "Leave all three empty and the AI writes questions for each product." },
    { "type": "text", "id": "question_1", "label": "Question 1" },
    { "type": "text", "id": "question_2", "label": "Question 2" },
    { "type": "text", "id": "question_3", "label": "Question 3" },
    { "type": "checkbox", "id": "show_note", "label": "Show the note under the input", "default": true }
  ]
}
{% endschema %}
