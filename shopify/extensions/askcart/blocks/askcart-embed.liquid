{%- comment -%}
  AskCart app embed (D39). Task 23 wrote the context capture and the schema; Task 26 added the widget source and the launcher strings.
  The config is public (it's the page source), so it never holds a secret. Every value leaves Liquid through
  `json` and then `escape`, so merchant text can't break out of the data attribute (Review Focus 2).
{%- endcomment -%}
{%- assign cfg = app.metafields.askcart.widget.value -%}
{%- if cfg.enabled -%}
  {%- capture product_id -%}{%- if request.page_type == 'product' and product -%}{{ product.id | append: '' | json }}{%- else -%}null{%- endif -%}{%- endcapture -%}
  {%- capture viewing -%}{%- if request.page_type == 'product' and product -%}{"title":{{ product.title | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},"price":{{ product.price | money | json }}}{%- else -%}null{%- endif -%}{%- endcapture -%}
  {%- capture ctx -%}
    {"shop":{{ shop.permanent_domain | json }},"locale":{{ request.locale.iso_code | json }},"country":{{ localization.country.iso_code | json }},"currency":{{ cart.currency.iso_code | json }},"productId":{{ product_id }},"cartAddUrl":{{ routes.cart_add_url | json }},"cartUrl":{{ routes.cart_url | json }},"privacyUrl":{{ shop.privacy_policy.url | json }},"designMode":{{ request.design_mode | json }},"loggedIn":{% if customer %}true{% else %}false{% endif %},"viewing":{{ viewing }}}
  {%- endcapture -%}
  {%- comment -%} C20: the chat script is an extension asset on Shopify's CDN; the launcher injects it on first click. {%- endcomment -%}
  <div
    id="askcart-root"
    data-config="{{ cfg | json | escape }}"
    data-page="{{ ctx | strip | escape }}"
    data-widget-src="{{ 'askcart-widget.js' | asset_url | escape }}"
    data-label="{{ 'launcher.label' | t | escape }}"
    data-aria-label="{{ 'launcher.aria_label' | t | escape }}"
    data-teaser="{{ 'launcher.teaser' | t | escape }}"
    data-teaser-close="{{ 'launcher.teaser_close' | t | escape }}"
    hidden
  ></div>
  {%- comment -%}
    Ask our AI agent below the Buy buttons, with no theme editing. The launcher copies this template in after the buy form
    (unless the merchant placed the block by hand) and loads the block's script; the stylesheet link rides inside the
    template so it loads only when the block is inserted, on product pages only. Questions are AI-written per product.
  {%- endcomment -%}
  {%- if block.settings.auto_ask_ai and request.page_type == 'product' and product and cfg.apiBase != blank -%}
    {%- assign ask_eyebrow = 'ask_ai.eyebrow' | t -%}
    {%- assign ask_heading = 'ask_ai.heading' | t -%}
    <template data-askcart-ask-ai-auto data-script="{{ 'askcart-ask-ai.js' | asset_url | escape }}">
      <link rel="stylesheet" href="{{ 'askcart-ask-ai.css' | asset_url | escape }}">
      {%- render 'askcart-ask-ai', cfg: cfg, product: product, eyebrow: ask_eyebrow, heading: ask_heading, pill_count: 3 -%}
    </template>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "AskCart chat",
  "target": "body",
  "javascript": "askcart-launcher.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_ask_ai",
      "label": "Show \"Ask our AI agent\" below Add to cart on product pages",
      "info": "If you place the block yourself in the theme editor, yours is used instead.",
      "default": true
    }
  ]
}
{% endschema %}
