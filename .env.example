DATABASE_ADMIN_URL=postgres://shopassist:shopassist@localhost:5432/shopassist
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_KEY=
SHOPIFY_APP_URL=
DATABASE_URL=postgres://app_user:app_user@localhost:5432/shopassist
TEST_DATABASE_ADMIN_URL=postgres://shopassist:shopassist@localhost:5432/shopassist_test
TEST_DATABASE_URL=postgres://app_user:app_user@localhost:5432/shopassist_test
OPENAI_API_KEY=
# Signs chat conversation tokens; 32 random bytes, base64
CHAT_TOKEN_SECRET=
# Chat models (D34): the small model answers first and escalates to the large one
OPENAI_MODEL_SMALL=
OPENAI_MODEL_LARGE=
# D89: public URL of our UCP agent profile (public/ucp-agent-profile.json once deployed), needed by the Storefront
# Catalog MCP search provider. Unset → stores set to "mcp" or "hybrid" search with ours and log a line.
UCP_AGENT_PROFILE_URL=
# Partner connect (docs/partner-api.md): the app's handle in Shopify admin URLs, used to build the consent deep link
# https://admin.shopify.com/store/<store>/apps/<handle>/app/partner-consent. The dev-store check (P0) found that the
# app's client_id (same value as SHOPIFY_API_KEY) works here and "askcart" gives Shopify's 404.
SHOPIFY_APP_HANDLE=
# LEGACY until the portal switches to per-store tokens (C31); removed in Task P11.
# D70/D73: the old single-store shared-secret access to /api/partner/*. Locked to this one store; unset → the legacy
# path is off (401). Per-store tokens (ack_…) work either way.
PARTNER_STORE_DOMAIN=
# LEGACY (C31, removed in P11): Bearer secret for the legacy path; 32+ random bytes, base64. Unset → legacy calls 401.
PARTNER_API_SECRET=
