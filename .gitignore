# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/server/coverage

# next.js
/server/.next/
/server/out/

# production
/server/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# shopify
.shopify/
!.env.example
.superpowers/
.claude/

# widget build output (npm run build:widget), served from the extension assets (C20)
/shopify/extensions/askcart/assets/askcart-*.js
/server/public/embed.js
/server/public/askcart-hosted.js
